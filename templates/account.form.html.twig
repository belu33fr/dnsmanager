{% extends "generic_show_form.html.twig" %}
{% import "components/form/fields_macros.html.twig" as fields %}

{% block more_fields %}

    {# Injection des données pour le JS externe (public/account.form.js) #}
    <script>
    window.dnsmanagerData = {
        allProviderData:     {{ allProviderData|raw }},
        existingCredentials: {{ credentials|raw }},
        currentEndpoint:     '{{ currentEndpoint }}',
        accountId:           {{ item.fields['id'] ?? 0 }},
        i18n: {
            chooseEndpoint: {{ __("-- Choisir un endpoint --", "dnsmanager")|json_encode|raw }},
            noCredentials:  {{ __("Aucun credential requis.", "dnsmanager")|json_encode|raw }},
            unchanged:      {{ __("(inchangé)", "dnsmanager")|json_encode|raw }},
            keepPassword:   {{ __("Laissez les champs mot de passe vides pour conserver les credentials existants.", "dnsmanager")|json_encode|raw }},
            testRunning:    {{ __("Test en cours...", "dnsmanager")|json_encode|raw }},
            testOk:         {{ __("Connexion réussie !", "dnsmanager")|json_encode|raw }},
            failure:        {{ __("Échec :", "dnsmanager")|json_encode|raw }},
            commError:      {{ __("Erreur de communication.", "dnsmanager")|json_encode|raw }},
            syncStarting:   {{ __("Synchronisation en cours...", "dnsmanager")|json_encode|raw }},
            syncProgress:   {{ __("Synchronisation : {done} / {total} — {domain}", "dnsmanager")|json_encode|raw }},
            syncDone:       {{ __("Terminé.", "dnsmanager")|json_encode|raw }},
            syncSummary:    {{ __("{domains} domaine(s), {records} enregistrement(s).", "dnsmanager")|json_encode|raw }},
            syncErrors:     {{ __("Erreurs :", "dnsmanager")|json_encode|raw }},
            syncNothing:    {{ __("Aucun domaine à synchroniser pour ce compte.", "dnsmanager")|json_encode|raw }},
            syncAborted:    {{ __("Synchronisation interrompue : trop d'erreurs de communication consécutives.", "dnsmanager")|json_encode|raw }},
            statsRunning:   {{ __("Interrogation de l'hébergeur...", "dnsmanager")|json_encode|raw }},
            syncDuration:   {{ __("Durée : {time} — moyenne {avg} par domaine — {api} % du temps en appels à l'hébergeur ({calls} appels)", "dnsmanager")|json_encode|raw }},
            syncSlowest:    {{ __("Domaines les plus lents :", "dnsmanager")|json_encode|raw }},
            tabSync:        {{ __("Synchronisation", "dnsmanager")|json_encode|raw }},
            tabDone:        {{ __("Synchronisation terminée", "dnsmanager")|json_encode|raw }},
            tabDoneErr:     {{ __("Synchronisation terminée avec erreurs", "dnsmanager")|json_encode|raw }},
            cancel:         {{ __("Annuler", "dnsmanager")|json_encode|raw }},
            syncCancelling: {{ __("Annulation en cours (fin du domaine en cours)...", "dnsmanager")|json_encode|raw }},
            syncCancelled:  {{ __("Synchronisation annulée : {done} / {total} domaine(s) traité(s).", "dnsmanager")|json_encode|raw }}
        }
    };
    </script>

    {{ fields.smallTitle(__('Informations générales', 'dnsmanager')) }}

    {# Provider #}
    <div class="mb-3 row">
        <label class="col-xxl-4 col-form-label">{{ __('Provider', 'dnsmanager') }} *</label>
        <div class="col-xxl-8">
            <select name="provider_type" id="dns-provider-select" class="form-select" required>
                <option value="" {% if not item.fields['provider_type'] %}selected{% endif %} disabled>
                    -- {{ __('Choisir un provider', 'dnsmanager') }} --
                </option>
                {% for type, label in providers %}
                    <option value="{{ type }}" {% if item.fields['provider_type'] == type %}selected{% endif %}>
                        {{ label }}
                    </option>
                {% endfor %}
            </select>
        </div>
    </div>

    {# Champs masqués pour l'Observateur - valeur passée par showForm() #}
    {% set is_observer = not can_sync %}

    {% if not is_observer %}
        {# Endpoint #}
        <div class="mb-3 row" id="dns-endpoint-section">
            <label class="col-xxl-4 col-form-label">{{ __('Endpoint / Région', 'dnsmanager') }} *</label>
            <div class="col-xxl-8">
                <select name="endpoint" id="dns-endpoint-select" class="form-select" required>
                    <option value="" selected disabled>-- {{ __('Choisir un endpoint', 'dnsmanager') }} --</option>
                </select>
            </div>
        </div>
    {% endif %}

    {{ fields.dropdownField('Supplier', 'suppliers_id', item.fields['suppliers_id'], __('Fournisseur', 'dnsmanager'), {
        'display_emptychoice': true,
        'emptylabel': '-- ' ~ __('Choisir un fournisseur', 'dnsmanager') ~ ' --',
        'readonly': is_observer
    }) }}

    {% if not is_observer %}

        {{ fields.textField('domain_whitelist', item.fields['domain_whitelist'], __('Liste blanche des domaines', 'dnsmanager'), {
            'helper': __("Domaines séparés par virgules. Vide = tous les domaines éligibles.", 'dnsmanager')
        }) }}

        {{ fields.numberField('renewal_months', item.fields['renewal_months'] ?? 1, __('Préavis de facturation (mois)', 'dnsmanager'), {
            'min': 1, 'max': 12
        }) }}

        {{ fields.smallTitle(__("Contacts par défaut (copiés à l'import)", "dnsmanager")) }}

        {# Groupe et Groupe responsable sont gérés automatiquement par GLPI dans l'en-tête #}
        {# Ils sont mémorisés via groups_id et groups_id_tech dans la table du compte #}

        {% if accounts_class %}
        {{ fields.dropdownField(
            accounts_class,
            'plugin_accounts_accounts_id_administrateurfield',
            item.fields['plugin_accounts_accounts_id_administrateurfield'] ?? 0,
            __('Administrateur', 'dnsmanager'),
            {'display_emptychoice': true, 'condition': accounts_type_condition}
        ) }}

        {{ fields.dropdownField(
            accounts_class,
            'plugin_accounts_accounts_id_technicienfield',
            item.fields['plugin_accounts_accounts_id_technicienfield'] ?? 0,
            __('Technicien', 'dnsmanager'),
            {'display_emptychoice': true, 'condition': accounts_type_condition}
        ) }}

        {{ fields.dropdownField(
            accounts_class,
            'plugin_accounts_accounts_id_financierfield',
            item.fields['plugin_accounts_accounts_id_financierfield'] ?? 0,
            __('Financier', 'dnsmanager'),
            {'display_emptychoice': true, 'condition': accounts_type_condition}
        ) }}
        {% else %}
        <div class="alert alert-warning">
            <i class="ti ti-alert-triangle me-2"></i>{{ __('Plugin Accounts requis pour les contacts.', 'dnsmanager') }}
        </div>
        {% endif %}

        {{ fields.dropdownField(
            'Group',
            'contact_groups_id',
            item.fields['contact_groups_id'] ?? 0,
            __('Groupe concerné (comptes contacts créés)', 'dnsmanager'),
            {
                'display_emptychoice': true,
                'helper': __('Groupe assigné automatiquement aux nouveaux comptes contact créés depuis le registrar (Statut : Actif, Type : Fournisseur)', 'dnsmanager')
            }
        ) }}

        {{ fields.dropdownField(
            'User',
            'users_id_proprietairefield',
            item.fields['users_id_proprietairefield'] ?? 0,
            __('Propriétaire', 'dnsmanager'),
            {'display_emptychoice': true, 'right': 'all'}
        ) }}

        {{ fields.smallTitle(__('Authentification', 'dnsmanager')) }}

        {{ fields.textField('provider_key_name', item.fields['provider_key_name'], __('Nom de la clé chez le provider', 'dnsmanager'), {
            'helper': __("Libellé libre pour retrouver facilement cette clé API dans l'interface du provider (ex: OVH, Gandi) — utile si vous en gérez plusieurs.", 'dnsmanager')
        }) }}

        {# Rempli par account.form.js dès qu'un provider est choisi (vide à la création) #}
        <div id="dns-credentials-section" class="col-12 mb-3"></div>

        {% if item.fields['id'] > 0 %}
        <div class="col-12 mb-3 d-flex gap-2 flex-wrap">
            <button type="button" id="dns-btn-test" class="btn btn-primary">
                <i class="ti ti-plug me-1"></i>{{ __('Tester la connexion', 'dnsmanager') }}
            </button>
            <a href="{{ webdir }}/front/domain.import.php?account_id={{ item.fields['id'] }}"
               class="btn btn-primary" id="dns-btn-sync-interactive">
                <i class="ti ti-world-upload me-1"></i>{{ __('Rechercher nouveaux domaines', 'dnsmanager') }}
            </a>
            <button type="button" id="dns-btn-sync" class="btn btn-primary">
                <i class="ti ti-refresh me-1"></i>{{ __('Sync rapide', 'dnsmanager') }}
            </button>
        </div>
        {% endif %}
        <div id="dns-action-result" class="col-12 mb-3"></div>

        {% if item.fields['id'] > 0 and stats %}
        {{ fields.smallTitle(__('Statistiques', 'dnsmanager')) }}
        <div class="col-12 mb-3">
            <table class="table table-sm table-borderless w-auto mb-0">
                <tr>
                    <td class="text-muted pe-4">{{ __('Domaines dans GLPI (rattachés à ce compte)', 'dnsmanager') }}</td>
                    <td><strong id="dns-stat-glpi">{{ stats.glpi_domains }}</strong></td>
                </tr>
                <tr>
                    <td class="text-muted pe-4">{{ __("Domaines chez l'hébergeur", 'dnsmanager') }}</td>
                    <td>
                        <strong id="dns-stat-provider">—</strong>
                        <button type="button" id="dns-btn-stats" class="btn btn-sm btn-outline-secondary ms-2">
                            <i class="ti ti-refresh me-1"></i>{{ __('Actualiser', 'dnsmanager') }}
                        </button>
                    </td>
                </tr>
                <tr>
                    <td class="text-muted pe-4">{{ __("Domaines de l'hébergeur non rattachés à GLPI", 'dnsmanager') }}</td>
                    <td><strong id="dns-stat-notlinked">—</strong></td>
                </tr>
                <tr>
                    <td class="text-muted pe-4">{{ __('Dernière synchronisation des enregistrements', 'dnsmanager') }}</td>
                    <td id="dns-stat-lastrec">{{ stats.last_records_sync ?: '—' }}</td>
                </tr>
                <tr>
                    <td class="text-muted pe-4">{{ __('Dernier passage de synchronisation', 'dnsmanager') }}</td>
                    <td id="dns-stat-lastlog">{{ stats.last_log ?: '—' }}</td>
                </tr>
            </table>
        </div>
        {% endif %}

    {% else %}
        <div class="alert alert-info mt-2">
            <i class="ti ti-info-circle me-2"></i>{{ __("Accès en lecture seule.", "dnsmanager") }}
        </div>
    {% endif %}

{% endblock more_fields %}
