{% extends "generic_show_form.html.twig" %}
{% import "components/form/fields_macros.html.twig" as fields %}

{#
 # Fiche de base d'un hébergeur : le gabarit GLPI n'affiche ici que le nom (field_order = ['name']).
 # Les autres champs (type de provider, groupes, état, commentaire) sont placés ici, dans l'ordre voulu.
 # Extension, Contacts par défaut et Authentification sont des onglets natifs (src/AccountTabs.php).
 #}
{% block more_fields %}

    {% include '@dnsmanager/account.data.html.twig' %}

    {# Type de provider, directement après le nom #}
    <div class="form-field row col-12 col-sm-6 mb-2">
        <label class="col-form-label col-xxl-5 text-xxl-end" for="dns-provider-select">
            {{ __('Type de provider', 'dnsmanager') }} <span class="required">*</span>
        </label>
        <div class="col-xxl-7 field-container">
            <select name="provider_type" id="dns-provider-select" class="form-select" required>
                <option value="" {% if not item.fields['provider_type'] %}selected{% endif %} disabled>
                    -- {{ __('Choisir un provider', 'dnsmanager') }} --
                </option>
                {% for type, label in providers %}
                    <option value="{{ type }}" {% if item.fields['provider_type'] == type %}selected{% endif %}>
                        {{ label }}
                    </option>
                {% endfor %}
            </select>
        </div>
    </div>

    {{ fields.dropdownField(
        'Group',
        'groups_id_tech',
        item.fields['groups_id_tech'] ?? 0,
        __('Group in charge'),
        {
            'entity': item.fields['entities_id']|default(-1),
            'condition': {'is_assign': 1}
        }
    ) }}

    {{ fields.dropdownField(
        'Group',
        'groups_id',
        item.fields['groups_id'] ?? 0,
        'Group'|itemtype_name,
        {
            'entity': item.fields['entities_id']|default(-1),
            'condition': {'is_itemgroup': 1}
        }
    ) }}

    {{ fields.dropdownYesNo('is_active', item.fields['is_active'] ?? 1, __('Active')) }}

    {{ fields.textareaField('comment', item.fields['comment'] ?? '', _n('Comment', 'Comments', get_plural_number())) }}

    {% if item.fields['id'] > 0 %}
        {% if can_sync %}

        {# Zone de la fiche de base pilotée par account.form.js : statistiques, boutons, résultat #}
        <div class="col-12" id="dns-main-root">

            {% if stats %}
            {{ fields.smallTitle(__('Statistiques', 'dnsmanager')) }}
            <div class="col-12 mb-3">
                <table class="table table-sm table-borderless w-auto mb-0">
                    <tr>
                        <td class="text-muted pe-4">{{ __('Domaines dans GLPI (rattachés à ce compte)', 'dnsmanager') }}</td>
                        <td><strong id="dns-stat-glpi">{{ stats.glpi_domains }}</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted pe-4">{{ __("Domaines chez l'hébergeur", 'dnsmanager') }}</td>
                        <td>
                            <strong id="dns-stat-provider">{{ stats.provider_domains is not null ? stats.provider_domains : '—' }}</strong>
                            <button type="button" id="dns-btn-stats" class="btn btn-sm btn-outline-secondary ms-2">
                                <i class="ti ti-refresh me-1"></i>{{ __('Actualiser', 'dnsmanager') }}
                            </button>
                            <span class="text-muted small ms-2" id="dns-stat-checked">{{ stats.provider_checked }}</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted pe-4">{{ __("Domaines de l'hébergeur à importer", 'dnsmanager') }}</td>
                        <td><strong id="dns-stat-notlinked">{{ stats.provider_not_linked is not null ? stats.provider_not_linked : '—' }}</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted pe-4">{{ __('Dernière synchronisation des enregistrements', 'dnsmanager') }}</td>
                        <td id="dns-stat-lastrec">{{ stats.last_records_sync ?: '—' }}</td>
                    </tr>
                    <tr>
                        <td class="text-muted pe-4">{{ __('Dernier passage de synchronisation', 'dnsmanager') }}</td>
                        <td id="dns-stat-lastlog">{{ stats.last_log ?: '—' }}</td>
                    </tr>
                </table>
            </div>
            {% endif %}

            <div class="mb-3 d-flex gap-2 flex-wrap">
                <button type="button" id="dns-btn-test" class="btn btn-primary">
                    <i class="ti ti-plug me-1"></i>{{ __('Tester la connexion', 'dnsmanager') }}
                </button>
                <a href="{{ webdir }}/front/domain.import.php?account_id={{ item.fields['id'] }}"
                   class="btn btn-primary" id="dns-btn-sync-interactive">
                    <i class="ti ti-world-upload me-1"></i>{{ __('Rechercher nouveaux domaines', 'dnsmanager') }}
                </a>
                <button type="button" id="dns-btn-sync" class="btn btn-primary">
                    <i class="ti ti-refresh me-1"></i>{{ __('Sync rapide', 'dnsmanager') }}
                </button>
            </div>
            <div id="dns-action-result" class="mb-3"></div>
        </div>

        {% else %}
        <div class="alert alert-info mt-2">
            <i class="ti ti-info-circle me-2"></i>{{ __("Accès en lecture seule.", "dnsmanager") }}
        </div>
        {% endif %}
    {% endif %}

{% endblock more_fields %}
