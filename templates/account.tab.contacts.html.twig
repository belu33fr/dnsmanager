{% import "components/form/fields_macros.html.twig" as fields %}
{% include '@dnsmanager/account.data.html.twig' %}

{# Onglet Contacts par défaut : copiés à l'import des domaines #}
<div class="card-body">
    <form method="post" action="{{ item.getFormURL() }}" data-track-changes="true">
        <input type="hidden" name="id" value="{{ item.fields['id'] }}">

        <div class="row">
            {% if accounts_class %}
            {{ fields.dropdownField(
                accounts_class,
                'plugin_accounts_accounts_id_administrateurfield',
                item.fields['plugin_accounts_accounts_id_administrateurfield'] ?? 0,
                __('Administrateur', 'dnsmanager'),
                {'display_emptychoice': true, 'condition': accounts_type_condition}
            ) }}

            {{ fields.dropdownField(
                accounts_class,
                'plugin_accounts_accounts_id_technicienfield',
                item.fields['plugin_accounts_accounts_id_technicienfield'] ?? 0,
                __('Technicien', 'dnsmanager'),
                {'display_emptychoice': true, 'condition': accounts_type_condition}
            ) }}

            {{ fields.dropdownField(
                accounts_class,
                'plugin_accounts_accounts_id_financierfield',
                item.fields['plugin_accounts_accounts_id_financierfield'] ?? 0,
                __('Financier', 'dnsmanager'),
                {'display_emptychoice': true, 'condition': accounts_type_condition}
            ) }}
            {% else %}
            <div class="alert alert-warning">
                <i class="ti ti-alert-triangle me-2"></i>{{ __('Plugin Accounts requis pour les contacts.', 'dnsmanager') }}
            </div>
            {% endif %}

            {{ fields.dropdownField(
                'Group',
                'contact_groups_id',
                item.fields['contact_groups_id'] ?? 0,
                __('Groupe concerné (comptes contacts créés)', 'dnsmanager'),
                {
                    'display_emptychoice': true,
                    'helper': __('Groupe assigné automatiquement aux nouveaux comptes contact créés depuis le registrar (Statut : Actif, Type : Fournisseur)', 'dnsmanager')
                }
            ) }}

            {{ fields.dropdownField(
                'User',
                'users_id_proprietairefield',
                item.fields['users_id_proprietairefield'] ?? 0,
                __('Propriétaire', 'dnsmanager'),
                {'display_emptychoice': true, 'right': 'all'}
            ) }}
        </div>

        <div class="d-flex justify-content-end mt-3">
            <button type="submit" name="update" value="1" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
            </button>
        </div>
        {{ call('Html::closeForm', [false])|raw }}
</div>
